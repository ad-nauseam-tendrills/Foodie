# nginx vhost for running Foodie behind an existing nginx (e.g. sharing a
# droplet with other apps, each on their own subdomain).
#
# Install:
#   sudo cp deploy/nginx-site.conf.example /etc/nginx/sites-available/foodie
#   sudo sed -i 's/foodie.edgarbustos.art/foodie.example.com/g' \
#       /etc/nginx/sites-available/foodie
#   sudo ln -s /etc/nginx/sites-available/foodie /etc/nginx/sites-enabled/foodie
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then add TLS -- certbot rewrites this file, adding the 443 server block
# and an http -> https redirect:
#   sudo certbot --nginx -d foodie.edgarbustos.art
#
# This block claims a single server_name, so other sites on the same
# nginx (and their own certs) are unaffected.

server {
    server_name foodie.edgarbustos.art;

    # Matches docker-compose.yml's "127.0.0.1:3001:3000" port mapping --
    # change the port here too if you change it there.
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 80;
}
