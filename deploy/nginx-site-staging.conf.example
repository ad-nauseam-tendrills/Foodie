# nginx vhost for a staging copy of Foodie, running alongside production
# on the same droplet (separate container, separate port, separate data --
# see docker-compose.staging.yml).
#
# Install:
#   sudo cp deploy/nginx-site-staging.conf.example /etc/nginx/sites-available/foodie-staging
#   sudo sed -i 's/foodie-staging.edgarbustos.art/staging.your-domain.com/g' \
#       /etc/nginx/sites-available/foodie-staging
#   sudo ln -s /etc/nginx/sites-available/foodie-staging /etc/nginx/sites-enabled/foodie-staging
#   sudo nginx -t && sudo systemctl reload nginx
#
# Then add TLS -- certbot rewrites this file, adding the 443 server block
# and an http -> https redirect:
#   sudo certbot --nginx -d foodie-staging.edgarbustos.art
#
# Point an A record for the staging subdomain at the droplet's IP first.

server {
    server_name foodie-staging.edgarbustos.art;

    # Matches docker-compose.staging.yml's "127.0.0.1:3002:3000" port
    # mapping -- change the port here too if you change it there.
    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 80;
}
